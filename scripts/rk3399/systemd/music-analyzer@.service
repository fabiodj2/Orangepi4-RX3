[Unit]
Description=rx3-analyze: Tier-1 analysis worker %i
After=music-analyze-watch.service
Requires=music-analyze-watch.service

[Service]
Type=simple
ExecStart=/usr/local/bin/music-analyze-worker.sh
Restart=on-failure
RestartSec=2
Nice=10
# Pinned to the A53 set by the worker script itself (RX3_ANALYZE_CPUS,
# default 0-3) -- the same cores JuceALSA is pinned to by start-rk3399.sh.
# RE-MEASURE with the live stack running and a track playing before
# enabling more than one of these at once; see
# docs/rk3399/01-music-analysis.md's correction against the benchmark.
User=orangepi
Group=orangepi

[Install]
WantedBy=multi-user.target

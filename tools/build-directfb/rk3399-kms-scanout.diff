+/*
+ * 565 -> 8888, fast. The per-pixel walk below costs ~10.8 ms at 1728x1080 into a
+ * write-combined KMS buffer on the RK3399; this does the same picture with:
+ *   - a 64 K-entry conversion table (256 KB, built once, stays in L2);
+ *   - the source column of every output pixel computed once per geometry;
+ *   - each SOURCE row converted once, into a cached row buffer, and every output
+ *     row that samples it (800 -> 1080 repeats ~1 in 3) copied out with memcpy,
+ *     which is what write-combined memory wants: long sequential bursts.
+ * Same sampling as the walk (stepx/stepy, half-step origin), so the same pixels.
+ * Returns 0 if it could not allocate, and the caller walks instead.
+ */
+static int
+fbdev_present_scale_565_8888( const unsigned char *src, int sw, int sh, int spitch,
+                              unsigned char *dst, int fpitch, int dx, int dy, int dw, int dh )
+{
+     static unsigned int *lut;
+     static unsigned int *row;
+     static int          *xi;
+     static int           xi_dw = -1, xi_sw = -1;
+     unsigned int stepx = (unsigned int)(((unsigned long long)sw << 16) / (unsigned)dw);
+     unsigned int stepy = (unsigned int)(((unsigned long long)sh << 16) / (unsigned)dh);
+     unsigned int accy  = stepy >> 1;
+     int          last  = -1;
+     int          x, y;
+
+     if (!lut) {
+          lut = malloc( 65536 * sizeof *lut );
+          if (!lut)
+               return 0;
+          for (x = 0; x < 65536; x++)
+               lut[x] = rgb565_to_rgb32( (unsigned short)x );
+     }
+     if (xi_dw != dw || xi_sw != sw) {
+          unsigned int acc = stepx >> 1;
+
+          free( xi );
+          free( row );
+          xi  = malloc( (size_t)dw * sizeof *xi );
+          row = malloc( (size_t)dw * sizeof *row );
+          if (!xi || !row) {
+               free( xi ); free( row ); xi = NULL; row = NULL; xi_dw = -1;
+               return 0;
+          }
+          for (x = 0; x < dw; x++, acc += stepx)
+               xi[x] = (int)(acc >> 16);
+          xi_dw = dw;
+          xi_sw = sw;
+     }
+
+     for (y = 0; y < dh; y++, accy += stepy) {
+          int sy = (int)(accy >> 16);
+
+          if (sy != last) {
+               const unsigned short *s = (const unsigned short *)(src + (size_t)sy * spitch);
+
+               for (x = 0; x < dw; x++)
+                    row[x] = lut[s[xi[x]]];
+               last = sy;
+          }
+          memcpy( dst + (size_t)(y + dy) * fpitch + (size_t)dx * 4, row, (size_t)dw * 4 );
+     }
+     return 1;
+}

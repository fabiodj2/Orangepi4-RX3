+/*
+ * THE KMS SCANOUT, when the preloaded shim offers one (fbshim's drmband.c,
+ * rx3_kms_scanout, behind KMS_SCANOUT=1). On a board whose /dev/fb0 is a
+ * deferred-I/O shadow -- rockchip-drm on the RK3399 -- every write to the fb
+ * mapping faults and the kernel copies the damage to the real buffer on its own
+ * clock, which made a 565->8888 scale cost 15.6 ms here against the Pi's 3.3 ms
+ * and tore frames. The shim puts a dumb buffer of the fb's geometry on the
+ * primary plane; the present writes there instead, and does not pan (the plane
+ * is not the fb). Looked up once; NULL = the fb route, unchanged.
+ */
+static int (*kms_vsync)( void );
+
+static unsigned char *
+fbdev_kms_scanout( int fw, int fh, int dbpp, int *fpitch )
+{
+     static int            looked;
+     static unsigned char *pix;
+     static int            pitch;
+
+     if (!looked) {
+          void *(*fn)( int, int, int, int * );
+
+          looked = 1;
+          fn = (void *(*)( int, int, int, int * )) dlsym( RTLD_DEFAULT, "rx3_kms_scanout" );
+          if (fn)
+               pix = fn( fw, fh, dbpp * 8, &pitch );
+          if (pix && !getenv( "KMS_NO_VSYNC" ))
+               kms_vsync = (int (*)( void )) dlsym( RTLD_DEFAULT, "rx3_kms_vsync" );
+          if (pix)
+               D_INFO( "FBDev/Present: KMS scanout %dx%d pitch %d -- presenting there, "
+                       "not to /dev/fb0\n", fw, fh, pitch );
+     }
+     if (pix)
+          *fpitch = pitch;
+     return pix;
+}
